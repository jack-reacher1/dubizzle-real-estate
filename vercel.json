{
  "version": 2,
  "builds": [
    { "src": "vercel_api_index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/vercel_api_index.py" }
  ],
  "crons": [
    { "path": "/api/cron/scrape", "schedule": "0 23 * * *" },
    { "path": "/api/cron/scrape", "schedule": "0 9 * * *" },
    { "path": "/api/cron/scrape", "schedule": "0 15 * * *" }
  ]
}
