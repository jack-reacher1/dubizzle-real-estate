{
  "version": 2,
  "builds": [
    { "src": "vercel_api_index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/vercel_api_index.py" }
  ],
  "crons": [
    { "path": "/api/cron/scrape", "schedule": "0 0 1-7 * *" },
    { "path": "/api/cron/scrape", "schedule": "0 8 1-7 * *" },
    { "path": "/api/cron/scrape", "schedule": "0 16 1-7 * *" }
  ]
}
