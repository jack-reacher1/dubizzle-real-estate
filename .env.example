# Database connection for Supabase/Postgres metadata
DATABASE_URL=postgresql://user:password@host:5432/postgres
ASYNCPG_STATEMENT_CACHE_SIZE=0

# Local app server settings
APP_HOST=127.0.0.1
APP_PORT=8010
APP_DEFAULT_PER_PAGE=20
APP_MAX_PER_PAGE=200

# Local data file names and directory
DATA_DIR=data
LISTINGS_CSV_NAME=listings.csv
SELLERS_CSV_NAME=sellers_cache.csv
BUSINESS_CSV_NAME=business_listings.csv
SCRAPE_STATUS_JSON_NAME=scrape_status.json

# Dubizzle source site configuration
DUBIZZLE_BASE_URL=https://www.dubizzle.com.eg
DUBIZZLE_SALE_URL=https://www.dubizzle.com.eg/en/properties/apartments-duplex-for-sale/5th-settlement/
DUBIZZLE_RENT_URL=https://www.dubizzle.com.eg/en/properties/apartments-duplex-for-rent/5th-settlement/
DUBIZZLE_MAX_PAGES=25
DUBIZZLE_FRESHNESS_DAYS=14
DUBIZZLE_INACTIVE_RETENTION_DAYS=30
DUBIZZLE_MIN_DELAY_SECONDS=3
DUBIZZLE_MAX_DELAY_SECONDS=8
DUBIZZLE_REQUEST_TIMEOUT_SECONDS=90
DUBIZZLE_MAX_RETRIES=2
DUBIZZLE_BACKOFF_MAX_RETRIES=5
DUBIZZLE_BACKOFF_BASE_SECONDS=5
DUBIZZLE_BACKOFF_MAX_SECONDS=300

# Seller verification and classification thresholds
OWNER_RECHECK_DAYS=30
BROKER_ACTIVE_ADS_THRESHOLD=4
